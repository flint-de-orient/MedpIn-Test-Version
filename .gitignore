# --- Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
# Keep .env.example tracked (it carries no secrets); ignore every other .env.
!.env.example

# --- Crash dumps / junk ---
*.stackdump

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# --- Patient data: never commit ---
backend/uploads/
backend/logs/
*.log

# --- Flutter / Dart ---
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/app/upload-keystore.jks
mobile/**/GeneratedPluginRegistrant.*
mobile/lib/l10n/generated/

# --- Editors / OS ---
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# Firebase config. Identifies your project and is per-environment; keep it out
# of the repo so a fork or a leaked clone cannot address your users' devices.
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist
# Firebase service-account key. This one can send to every device you have.
firebase-adminsdk*.json
serviceAccountKey.json

# --- Local agent tooling ---
.claude/
.agents/
skills-lock.json
mobile/android/.kotlin/

# Release signing material. The keystore is irreplaceable — losing it means
# every installed user must uninstall before they can update again.
mobile/android/*.jks
mobile/android/*.keystore
mobile/android/app/*.jks
mobile/android/app/*.keystore
