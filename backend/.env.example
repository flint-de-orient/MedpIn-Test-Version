# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/akd_care
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/akd_care?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/akd_care

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=60d

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Set true only on MongoDB Atlas with a vector index created on
# knowledge_chunks.embedding. Local mongod uses in-process cosine similarity.
USE_ATLAS_VECTOR_SEARCH=false
VECTOR_INDEX_NAME=knowledge_vector_index

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12

# --- Clinic identity ---
CLINIC_NAME=Dr. Amit Kumar Dey Clinic
DOCTOR_DISPLAY_NAME=Dr. Amit Kumar Dey
CLINIC_EMERGENCY_PHONE=+91-9830000000

# --- Medication reminders ---
# Minutes a "before food" / "after food" dose is reminded before/after the meal.
# Applied whenever a schedule is (re)computed from the patient's meal times.
MEAL_OFFSET_BEFORE_MIN=30
MEAL_OFFSET_AFTER_MIN=30

# --- Production only ---
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ---- SMS one-time passcodes (MSG91) ----------------------------------------
# Leave blank in development: with no auth key the server logs the code instead
# of texting it, so the whole sign-in flow can be walked through without an SMS
# budget. In production that fallback refuses to run and the request fails.
#
# The two templates are registered with India's DLT registry against the sender
# ID; their wording is fixed there and cannot be edited from this app. Keep
# OTP_TTL_MINUTES at 10 unless the templates are re-registered — the message
# tells the patient "valid for 10 minutes only" and the two have to agree.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_LOGIN=
MSG91_TEMPLATE_REGISTER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
