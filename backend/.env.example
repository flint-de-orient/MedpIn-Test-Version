# MedPin API — environment
#
# Copy to .env on the server and fill in the blanks. Every key the code reads is
# listed here; anything with a value shown is a working default you can leave
# alone. Keys marked REQUIRED have no default and the server will not start
# without them.
#
#   cp .env.example .env && nano .env
#
# .env is gitignored. Never commit a filled-in copy.

# A NOTE THAT COSTS A DEPLOY IF MISSED
#
# A blank value is not an absent key. Where a setting below shows a default,
# writing `KEY=` with nothing after it makes the key PRESENT and EMPTY, and the
# schema's default no longer applies — DIETICIAN_INVITE_CODE requires four
# characters, so an empty one stops the server booting. To take a default,
# leave the line out or comment it.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ---- Database (REQUIRED) ---------------------------------------------------
MONGODB_URI=

# ---- Tokens (REQUIRED) -----------------------------------------------------
# At least 16 characters each, and different from one another. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing these signs every user out — that is the intended way to revoke.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Gemini (REQUIRED) -----------------------------------------------------
# Powers the two assistants, the lab-report reader, the prescription scanner and
# the foot/eye photo review. Without it those features fall back to scripted
# replies; everything else still works.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ---- Push notifications ----------------------------------------------------
# Absolute path to the Firebase service-account JSON on the server. Leave blank
# and no push is sent — the app still works, people just are not told.
# Keep the file outside the repo and readable only by the service user:
#   chmod 600 /etc/medpin/firebase.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/medpin/firebase.json

# ---- Search ----------------------------------------------------------------
# Atlas vector search for the knowledge base. Leave false on a self-hosted Mongo.
USE_ATLAS_VECTOR_SEARCH=false
VECTOR_INDEX_NAME=knowledge_vector_index

# ---- Uploads ---------------------------------------------------------------
# Where patient photos, lab PDFs, voice notes and logos are written. Must be
# writable by the service user and INCLUDED IN YOUR BACKUPS — these are clinical
# records and they do not live in Mongo.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Clinic identity -------------------------------------------------------
# Seed values only. Once the clinic profile is filled in from the app, the
# database wins and these are the fallback for a clinic that has not set one.
# Quoted because the value contains an apostrophe and an ampersand.
#
# dotenv reads it unquoted perfectly well, which is why this looked fine. A
# shell does not: `set -a; source .env` — how systemd EnvironmentFile and a few
# container entrypoints load it — hits the apostrophe, treats it as an opening
# quote, and hands back an EMPTY string. The clinic name would then vanish from
# every prescription letterhead and every AI prompt, silently, on one deploy
# method and not another.
CLINIC_NAME="Dr. Dey's Diabetes Obesity & Metabolic Clinic"
DOCTOR_DISPLAY_NAME="Dr. Amit Kumar Dey"

# The number a patient is TOLD TO RING IN AN EMERGENCY.
#
# Read out by the assistant, in all three languages, in the one reply where
# being wrong matters most. It used to default to +91-0000000000 and would have
# handed somebody with chest pain a number that rings nowhere.
#
# The server now REFUSES TO START in production without a real one. If you would
# rather it said nothing than gave a number, leave it blank and run with
# NODE_ENV=staging — the "or call ..." clause disappears entirely.
CLINIC_EMERGENCY_PHONE=

# Clinic-local time. Every appointment slot, reminder and "today" is computed in
# this zone, not the server's.
CLINIC_TZ=Asia/Kolkata

# ---- Dietician sign-up -----------------------------------------------------
# The code a dietician types to self-register. The doctor can rotate it from the
# app, and the stored one then wins over this.
# DIETICIAN_INVITE_CODE=

# ---- SMS one-time passcodes (MSG91) ----------------------------------------
# Required for OTP sign-in IN PRODUCTION. Without them the server refuses to
# send and throws; in development it logs the code instead so the flow can be
# walked through without spending an SMS.
#
# The two approved templates name their variable differently — ##OTP## in the
# login template, ##otp## in the register one. Both keys are sent on every
# request, so either spelling works; paste the template IDs exactly as MSG91
# shows them.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_LOGIN=
MSG91_TEMPLATE_REGISTER=

# How long a code lives, how many wrong guesses before it dies, and how long
# before Resend works. Ten minutes must match what the SMS template says, or the
# message and the server disagree in front of the patient.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ---- Medicine reminders ----------------------------------------------------
# Minutes either side of a meal time that a before/after-food dose is sent.
MEAL_OFFSET_BEFORE_MIN=15
MEAL_OFFSET_AFTER_MIN=30
