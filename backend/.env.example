# MedPin API — environment
#
# Copy to .env on the server and fill in the blanks. Every key the code reads is
# listed here; anything with a value shown is a working default you can leave
# alone. Keys marked REQUIRED have no default and the server will not start
# without them.
#
#   cp .env.example .env && nano .env
#
# .env is gitignored. Never commit a filled-in copy.

# A NOTE THAT COSTS A DEPLOY IF MISSED
#
# A blank value is not an absent key. Where a setting below shows a default,
# writing `KEY=` with nothing after it makes the key PRESENT and EMPTY, and the
# schema's default no longer applies — DIETICIAN_INVITE_CODE requires four
# characters, so an empty one stops the server booting. To take a default,
# leave the line out or comment it.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ---- Database (REQUIRED) ---------------------------------------------------
MONGODB_URI=

# ---- Tokens (REQUIRED) -----------------------------------------------------
# At least 16 characters each, and different from one another. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing these signs every user out — that is the intended way to revoke.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Gemini (REQUIRED) -----------------------------------------------------
# Powers the two assistants, the lab-report reader, the prescription scanner and
# the foot/eye photo review. Without it those features fall back to scripted
# replies; everything else still works.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ---- Push notifications ----------------------------------------------------
# Absolute path to the Firebase service-account JSON on the server. Leave blank
# and no push is sent — the app still works, people just are not told.
# Keep the file outside the repo and readable only by the service user:
#   chmod 600 /etc/medpin/firebase.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/medpin/firebase.json

# ---- Search ----------------------------------------------------------------
# Atlas vector search for the knowledge base. Leave false on a self-hosted Mongo.
USE_ATLAS_VECTOR_SEARCH=false
VECTOR_INDEX_NAME=knowledge_vector_index

# ---- Uploads ---------------------------------------------------------------
# Where patient photos, lab PDFs, voice notes and logos are written. Must be
# writable by the service user and INCLUDED IN YOUR BACKUPS — these are clinical
# records and they do not live in Mongo.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Clinic identity -------------------------------------------------------
# Seed values only. Once the clinic profile is filled in from the app, the
# database wins and these are the fallback for a clinic that has not set one.
# Quoted because the value contains an apostrophe and an ampersand.
#
# dotenv reads it unquoted perfectly well, which is why this looked fine. A
# shell does not: `set -a; source .env` — how systemd EnvironmentFile and a few
# container entrypoints load it — hits the apostrophe, treats it as an opening
# quote, and hands back an EMPTY string. The clinic name would then vanish from
# every prescription letterhead and every AI prompt, silently, on one deploy
# method and not another.
CLINIC_NAME="Dr. Dey's Diabetes Obesity & Metabolic Clinic"
DOCTOR_DISPLAY_NAME="Dr. Amit Kumar Dey"

# The number a patient is TOLD TO RING IN AN EMERGENCY.
#
# Read out by the assistant, in all three languages, in the one reply where
# being wrong matters most. It used to default to +91-0000000000 and would have
# handed somebody with chest pain a number that rings nowhere.
#
# The server now REFUSES TO START in production without a real one. If you would
# rather it said nothing than gave a number, leave it blank and run with
# NODE_ENV=staging — the "or call ..." clause disappears entirely.
CLINIC_EMERGENCY_PHONE=

# Clinic-local time. Every appointment slot, reminder and "today" is computed in
# this zone, not the server's.
CLINIC_TZ=Asia/Kolkata

# The clinic-local hour (0-23) at which clinicians who decide are pushed how
# many of their patients wrote that day and how many need them. It names nobody.
CHAT_DIGEST_HOUR=19

# ---- Dietician sign-up -----------------------------------------------------
# The code a dietician types to self-register. The doctor can rotate it from the
# app, and the stored one then wins over this.
# DIETICIAN_INVITE_CODE=

# ---- SMS one-time passcodes (MSG91) ----------------------------------------
# Required for OTP sign-in IN PRODUCTION. Without them the server refuses to
# send and throws; in development it logs the code instead so the flow can be
# walked through without spending an SMS.
#
# The two approved templates name their variable differently — ##OTP## in the
# login template, ##otp## in the register one. Both keys are sent on every
# request, so either spelling works; paste the template IDs exactly as MSG91
# shows them.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_LOGIN=
MSG91_TEMPLATE_REGISTER=

# How long a code lives, how many wrong guesses before it dies, and how long
# before Resend works. Ten minutes must match what the SMS template says, or the
# message and the server disagree in front of the patient.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ---- Which deployment this is ----------------------------------------------
# production, staging or development. Staging runs NODE_ENV=production and says
# so here, so readiness can check it holds no live SMS or push credentials.
# Commented, because a blank value is not in the list and the server will not
# start; leave it out to mean development.
# DEPLOY_ENV=production

# ---- Browsers allowed to call the API ---------------------------------------
# Comma-separated origins, read in production only. The operator console proxies
# the API from its own host and needs no entry here — which is why empty is a
# working setting rather than an oversight, and why readiness calls it `off`.
# Needed as soon as a browser calls this API from a different host.
# Scheme, host and port, exactly: https://admin.example.in — no path, and
# https://admin.example.in/ is trimmed rather than left to fail silently.
ALLOWED_ORIGINS=

# ---- Operator console -------------------------------------------------------
# The console's own signing key: 32 characters or more, and different from both
# token secrets above. Blank switches the console off — every admin route,
# including the queue where practice applications are approved, answers 404.
ADMIN_JWT_SECRET=
# Where the console lives, e.g. https://admin.example.in. Used for the links in
# the emails a practice application sends. Blank sends them without a link.
ADMIN_CONSOLE_URL=

# ---- Email ------------------------------------------------------------------
# Sends an applicant their reference and every decision on their application,
# and an operator their password reset. With SMTP_HOST or SMTP_USER blank, each
# message is written to the server log instead of sent.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# The From address. Blank uses SMTP_USER, which some providers refuse.
SMTP_FROM=
# 587 (STARTTLS) unless the provider says 465. Commented: a blank port is port 0.
# SMTP_PORT=587

# ---- Practice self-signup ---------------------------------------------------
# Applications one address may file an hour (default 6). Commented: a blank
# value fails the minimum and the server will not start.
# APPLICATION_RATE_LIMIT=6
# Minutes a verified number stays verified while the form is filled in (default
# 30). Separate from OTP_TTL_MINUTES, which the SMS template fixes at ten.
# APPLICATION_PHONE_TOKEN_MINUTES=30

# ---- Medicine reminders ----------------------------------------------------
# Minutes either side of a meal time that a before/after-food dose is sent.
MEAL_OFFSET_BEFORE_MIN=15
MEAL_OFFSET_AFTER_MIN=30

# --- App version gate -------------------------------------------------------
# Which build of the Android app this server will talk to.
#
# ANDROID_MIN_BUILD is a floor, not a preference. Below it the client is known
# to MISBEHAVE against this server rather than merely be old — the prescription
# scan is the reason it exists: it stopped creating medicines and began
# returning a preview, so an older app photographs a prescription, reads an
# empty list and shows the patient nothing at all. No error and no clue.
#
# Raise it ONLY when an older build is genuinely broken against this server, and
# only once the new APK is actually available at APP_DOWNLOAD_URL. Everything
# below the floor is locked out of the app entirely.
#
# Both default to 0, which gates nobody. That is deliberate: locking a patient
# out of their own medicines because a variable was mistyped is a worse failure
# than somebody running a slightly old app.
ANDROID_MIN_BUILD=0
ANDROID_LATEST_BUILD=0
ANDROID_LATEST_VERSION=
# Where a blocked patient actually gets the new app. Left blank, the app tells
# them to contact the clinic rather than showing a button that goes nowhere.
APP_DOWNLOAD_URL=

# ---- Subscriptions and payment (Razorpay) -----------------------------------
#
# Blank is a working state. With no RAZORPAY_KEY_ID the billing surface is off
# and nothing about the clinic changes — the same way the admin console is off
# without ADMIN_JWT_SECRET. A half-configured payment integration is worse than
# an absent one, because it can take money it cannot then confirm.
#
# From the Razorpay dashboard, Settings -> API Keys. The test keys are prefixed
# rzp_test_ and the live ones rzp_live_; the prefix is the only thing that says
# which mode you are in, so check it before going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# NOT the same as the key secret, and not interchangeable with it.
#
# Set separately under Settings -> Webhooks when you create the endpoint, and
# used only to verify that a callback came from Razorpay rather than from
# somebody who guessed the URL. Checking a webhook signature with the API
# secret fails open: every forged "payment succeeded" is accepted.
RAZORPAY_WEBHOOK_SECRET=

# Plan ids from Subscriptions -> Plans. The price lives in the dashboard; these
# only point at it. One per plan the app sells, so a missing one is caught at
# startup rather than as an undefined at checkout.
RAZORPAY_PLAN_ESSENTIAL=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_ENTERPRISE=

# Where the customer lands after paying. Absolute, and not derived from the
# request — a callback built from a forged Host header sends somebody to
# another server with a real payment id.
RAZORPAY_CALLBACK_URL=

# ---- Brand shown at checkout ------------------------------------------------
#
# This server's own public origin, e.g. https://clinq.example.in
#
# Razorpay's checkout fetches our logo from the customer's handset while they
# are typing a card number, so the URL it is handed has to be absolute. It is
# not derived from the request: a Host header is attacker-controlled, and a
# brand URL built from one is a logo somebody else chooses.
#
# Left blank, the app sends no image and Razorpay falls back to the first letter
# of the name — which is what it did before, and better than a broken image.
PUBLIC_API_ORIGIN=
BRAND_NAME=MedPin

# Days between a subscription's retries being exhausted and growth being
# withheld. 0 withholds nothing, ever. Nothing clinical is ever withheld.
BILLING_GRACE_DAYS=7
