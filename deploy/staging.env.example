# Staging configuration. Copy to /var/www/clinq-staging/backend/.env
#
# ---- Read this before copying production's .env instead ------------------
#
# Do not. The fastest way to stand up a second environment is to copy the
# first one's configuration, and doing that here gives a rehearsal box the
# ability to text and push real patients — quietly, because every outward
# channel in this application is credential-gated and fails silent-and-safe
# when the credentials are absent.
#
# `DEPLOY_ENV=staging` below is what lets the server notice. It reports
# `stagingIsolation: degraded` at boot and on GET /admin/readiness if any live
# messaging credential is present. That check exists precisely because copying
# the file is the natural thing to do.

# ---- identity ------------------------------------------------------------

# Production-mode behaviour, staging identity. Both, deliberately.
#
# NODE_ENV=production because half of what is worth rehearsing only happens
# there: error detail is withheld, cookies are Secure, the scheduler arms. A
# staging box in development mode rehearses a different application.
#
# DEPLOY_ENV=staging because, running that way, nothing else in the process
# knows it is not the real thing.
NODE_ENV=production
DEPLOY_ENV=staging
PORT=4001

# ---- database ------------------------------------------------------------

# Its own database, not its own collection prefix.
#
# The database name is the boundary. A shared database with a prefix is one
# `dropDatabase` or one forgotten filter away from production data, and the
# scripts in backend/scripts/ are written to operate on whatever they are
# pointed at.
MONGODB_URI=mongodb://127.0.0.1:27017/medpin_staging

# ---- secrets: generate fresh, never copy ---------------------------------
#
#   openssl rand -base64 48
#
# Fresh values mean a token minted on staging cannot be presented to
# production. Copying them makes the two environments one trust domain, which
# undoes most of the reason for having two.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=

# ---- outward channels: deliberately empty --------------------------------
#
# Every one of these logs instead of sending when unset, so staging exercises
# the same code paths and reaches nobody. Fill one in only for a specific
# test, on the day you run it, and take it back out afterwards.
#
# MSG91_AUTH_KEY / MSG91_SENDER_ID — SMS one-time passcodes to real numbers
# GOOGLE_APPLICATION_CREDENTIALS   — push to every registered handset
# SMTP_HOST                        — application decisions, password resets
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_HOST=

# ---- AI ------------------------------------------------------------------
#
# Required — the server refuses to boot without it. Use a separate key with
# its own quota if you have one: a staging run that exhausts production's
# allowance takes the assistant away from a live clinic.
GEMINI_API_KEY=

# ---- payments: test keys, and a webhook secret that is not the API secret --
#
# Razorpay test keys are already what production uses, so these can be the
# same values. The webhook secret must still differ from the API secret —
# using one for both is the commonest way this integration is got wrong, and
# it fails by rejecting every genuine callback, so subscriptions silently
# never activate.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ESSENTIAL=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_ENTERPRISE=
RAZORPAY_CALLBACK_URL=https://staging.clinq.flintdeorient.in/api/v1/billing/return

# ---- origins -------------------------------------------------------------

PUBLIC_API_ORIGIN=https://staging.clinq.flintdeorient.in

# Staging's own console, if one is deployed. Left blank, applicants on staging
# cannot confirm their email address — which is a thing worth rehearsing
# deliberately rather than discovering.
ADMIN_CONSOLE_URL=

# ---- storage -------------------------------------------------------------

# Its own directory. A shared uploads path is the one place the two
# environments would genuinely share state, and a staging test that deletes an
# asset would delete a patient's lab report.
UPLOAD_DIR=/var/www/clinq-staging/uploads

# ---- the clinic this deployment represents -------------------------------
#
# The server refuses to boot without a contact number — see
# assertClinicContactConfigured. Use a number that is not the clinic's: an
# emergency reply generated on staging should not send anybody to a real
# consulting room.
CLINIC_EMERGENCY_PHONE=
CLINIC_TZ=Asia/Kolkata
